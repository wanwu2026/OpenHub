# 构建上下文里排除敏感数据与临时产物，防止私钥/数据库被 COPY 进镜像层
.git
.gitignore
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# 运行时数据，绝不进镜像（由卷挂载）
data/
*.db
*.db-journal

# 私钥与密钥（由卷只读挂载）
*.pem
*.key
*.jks
deploy/.env
deploy/.env.*

# 文档/测试不进镜像（减小体积；CI 在本地跑，不需要打进产物）
docs/
tests/
README*.md
CHANGELOG.md
CONTRIBUTING.md
SECURITY.md
